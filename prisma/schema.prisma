generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Role {
  id           String       @id @default(cuid())
  displayName  String
  roleName     String       @unique
  description  String?
  permissions  String[]
  orgId        String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  users        User[]       @relation("UserRoles")

  @@index([roleName])
}

model User {
  id                        String                      @id @default(cuid())
  name                      String
  firstName                 String
  lastName                  String
  phone                     String                      @unique
  email                     String                      @unique
  emailVerified             DateTime?
  image                     String?
  jobTitle                  String?
  password                  String?
  status                    Boolean                     @default(true)
  orgName                   String?
  orgId                     String
  isVerfied                 Boolean                     @default(false)
  token                     String?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  roleId                    String?
  locationId                String?
  locationName              String?
  apiKey                    String?                     @unique
  accounts                  Account[]
  approvedAdjustments       Adjustment[]                @relation("AdjustmentApprovedBy")
  createdAdjustments        Adjustment[]                @relation("AdjustmentCreatedBy")
  feedbacks                 Feedback[]
  receivedGoodsReceipts     GoodsReceipt[]              @relation("GoodsReceiptReceivedBy")
  inventoryTransactions     InventoryTransaction[]
  approvedPurchaseOrders    PurchaseOrder[]             @relation("PurchaseOrderApprovedBy")
  createdPurchaseOrders     PurchaseOrder[]             @relation("PurchaseOrderCreatedBy")
  createdSalesOrders        SalesOrder[]                @relation("SalesOrderCreatedBy")
  Saving                    Saving[]
  sessions                  Session[]
  showcases                 Showcase[]
  approvedTransfers         Transfer[]                  @relation("TransferApprovedBy")
  createdTransfers          Transfer[]                  @relation("TransferCreatedBy")
  Location                  Location?                   @relation(fields: [locationId], references: [id])
  organisation              Organisation                @relation(fields: [orgId], references: [id], onDelete: Cascade)
  roles                     Role[]                      @relation("UserRoles")
  createdReturns            SalesReturn[]               @relation("ReturnCreatedBy")
  approvedReturns           SalesReturn[]               @relation("ReturnApprovedBy")
  recordedPayments          SalesOrderPayment[]         @relation("PaymentRecordedBy")
  recordedSupplierPayments  SupplierPayment[]           @relation("SupplierPaymentRecorder")
  ManualDebtPayment         ManualDebtPayment[]
  ManualSupplierDebtPayment ManualSupplierDebtPayment[]
}

model Organisation {
  id                    String                 @id @default(cuid())
  name                  String
  slug                  String                 @unique
  industry              String?
  country               String?
  region                String?
  address               String?
  currency              String?
  timezone              String?
  inventoryStartDate    DateTime?              @map("inventory_start_date")
  fiscalYear            Int?                   @map("fiscal_year")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  adjustments           Adjustment[]
  apikeys               ApiKey[]
  brands                Brand[]
  categories            Category[]
  customers             Customer[]
  goodsReceipts         GoodsReceipt[]
  inventories           Inventory[]
  inventoryTransactions InventoryTransaction[]
  invites               Invite[]
  items                 Item[]
  locations             Location[]
  purchaseOrders        PurchaseOrder[]
  roles                 Role[]
  salesOrders           SalesOrder[]
  suppliers             Supplier[]
  taxRates              TaxRate[]
  transfers             Transfer[]
  units                 Unit[]
  users                 User[]
  packagingUnits        PackagingUnit[]
  salesReturns          SalesReturn[]
  Expense               Expense[]
  PayrollEntry          PayrollEntry[]
  supplierPayments      SupplierPayment[]
  ManualDebt            ManualDebt[]
  ManualSupplierDebt    ManualSupplierDebt[]

  @@map("organisations")
}

model Location {
  id                    String                 @id @default(cuid())
  name                  String
  type                  LocationType
  address               String?
  phone                 String?
  email                 String?
  orgId                 String
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  adjustments           Adjustment[]
  goodsReceipts         GoodsReceipt[]
  inventories           Inventory[]
  inventoryTransactions InventoryTransaction[]
  organisation          Organisation           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  purchaseOrders        PurchaseOrder[]        @relation("DeliveryLocation")
  salesOrders           SalesOrder[]           @relation("SalesLocation")
  outgoingTransfers     Transfer[]             @relation("FromLocation")
  incomingTransfers     Transfer[]             @relation("ToLocation")
  users                 User[]
  salesReturns          SalesReturn[]
  adjustmentLines       AdjustmentLine[]
}

model Category {
  id            String       @id @default(cuid())
  title         String
  slug          String       @unique
  imageUrl      String?
  description   String?
  orgId         String
  parentId      String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  organisation  Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parent        Category?    @relation("SubCategories", fields: [parentId], references: [id])
  subCategories Category[]   @relation("SubCategories")
  items         Item[]
}

model Unit {
  id           String       @id @default(cuid())
  name         String
  symbol       String
  orgId        String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  items        Item[]
  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model Brand {
  id           String       @id @default(cuid())
  name         String
  slug         String       @unique
  orgId        String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  items        Item[]
}

model TaxRate {
  id           String       @id @default(cuid())
  name         String
  rate         Float
  orgId        String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  items        Item[]
  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model Saving {
  id          String    @id @default(cuid())
  amount      Int
  month       String
  name        String
  userId      String
  paymentDate DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Item {
  id                    String                 @id @default(cuid())
  name                  String
  sku                   String                 @unique
  slug                  String                 @unique
  barcode               String?                @unique
  description           String?
  dimensions            String?
  weight                Float?
  upc                   String?
  ean                   String?
  mpn                   String?
  isbn                  String?
  orgId                 String
  imageUrl              String[]
  thumbnail             String?                @default("https://3mkq65v2if.ufs.sh/f/nEsxSqMfLeqN5a4owpbHBYgvTZ8SDtkMErGQOR6d42fKLCoP")
  categoryId            String?
  salesCount            Int                    @default(0)
  salesTotal            Float                  @default(0)
  taxRateId             String?
  tax                   Float?                 @default(0)
  brandId               String?
  unitId                String?
  unitOfMeasure         String?
  costPrice             Float                  @default(0)
  sellingPrice          Float                  @default(0)
  minStockLevel         Int                    @default(0)
  maxStockLevel         Int?
  isActive              Boolean                @default(true)
  isSerialTracked       Boolean                @default(false)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  adjustmentLines       AdjustmentLine[]
  goodsReceiptLines     GoodsReceiptLine[]
  inventories           Inventory[]
  inventoryTransactions InventoryTransaction[]
  brand                 Brand?                 @relation(fields: [brandId], references: [id])
  category              Category?              @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  organisation          Organisation           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  taxRate               TaxRate?               @relation(fields: [taxRateId], references: [id])
  unit                  Unit?                  @relation(fields: [unitId], references: [id], onDelete: Cascade)
  supplierRelations     ItemSupplier[]
  purchaseOrderLines    PurchaseOrderLine[]
  salesOrderLines       SalesOrderLine[]
  serialNumbers         SerialNumber[]
  transferLines         TransferLine[]
  suppliers             Supplier[]             @relation("SupplierItems")
  pricingTiers          ItemPricingTier[]
  salesReturnLines      SalesReturnLine[]
}

model Supplier {
  id                 String               @id @default(cuid())
  name               String
  contactPerson      String?
  email              String?
  phone              String?
  address            String?
  taxId              String?
  orgId              String
  paymentTerms       Int?
  notes              String?
  isActive           Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  supplierRelations  ItemSupplier[]
  purchaseOrders     PurchaseOrder[]
  organisation       Organisation         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  items              Item[]               @relation("SupplierItems")
  ManualSupplierDebt ManualSupplierDebt[]
}

model ItemSupplier {
  id               String    @id @default(cuid())
  itemId           String
  supplierId       String
  isPreferred      Boolean   @default(false)
  supplierSku      String?
  leadTime         Int?
  minOrderQty      Int?
  unitCost         Float?
  lastPurchaseDate DateTime?
  notes            String?
  item             Item      @relation(fields: [itemId], references: [id])
  supplier         Supplier  @relation(fields: [supplierId], references: [id])

  @@unique([itemId, supplierId])
}

model Inventory {
  id               String       @id @default(cuid())
  itemId           String
  locationId       String
  quantity         Int          @default(0)
  reservedQuantity Int          @default(0)
  orgId            String
  stockStatus      StockStatus  @default(OUT_OF_STOCK)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  item             Item         @relation(fields: [itemId], references: [id])
  location         Location     @relation(fields: [locationId], references: [id])
  organisation     Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([itemId, locationId])
  @@index([itemId])
  @@index([locationId])
}

model SerialNumber {
  id              String       @id @default(cuid())
  serialNumber    String       @unique
  itemId          String
  status          SerialStatus @default(IN_STOCK)
  locationId      String?
  purchaseOrderId String?
  salesOrderId    String?
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  item            Item         @relation(fields: [itemId], references: [id])
}

model PurchaseOrder {
  id                   String                @id @default(cuid())
  poNumber             String                @unique
  date                 DateTime
  supplierId           String
  address              String
  supplierName         String?
  deliveryLocationId   String
  status               PurchaseOrderStatus   @default(DRAFT)
  subtotal             Float                 @default(0)
  taxAmount            Float                 @default(0)
  shippingCost         Float?
  discount             Float?                @default(0)
  amountPaid           Float                 @default(0)
  amountOwing          Float                 @default(0)
  paymentStatus        SupplierPaymentStatus @default(UNPAID)
  payments             SupplierPayment[]
  notes                String?
  paymentTerms         String?
  expectedDeliveryDate DateTime?
  orgId                String
  createdById          String
  approvedById         String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  goodsReceipts        GoodsReceipt[]
  approvedBy           User?                 @relation("PurchaseOrderApprovedBy", fields: [approvedById], references: [id])
  createdBy            User                  @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id])
  deliveryLocation     Location              @relation("DeliveryLocation", fields: [deliveryLocationId], references: [id])
  organisation         Organisation          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  supplier             Supplier              @relation(fields: [supplierId], references: [id])
  lines                PurchaseOrderLine[]

  @@index([poNumber])
  @@index([supplierId])
}

model PurchaseOrderLine {
  id                String             @id @default(cuid())
  purchaseOrderId   String
  itemId            String
  quantity          Int
  unitPrice         Float
  taxRate           Float              @default(0)
  taxAmount         Float              @default(0)
  discount          Float?
  total             Float
  receivedQuantity  Int                @default(0)
  notes             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  goodsReceiptLines GoodsReceiptLine[]
  item              Item               @relation(fields: [itemId], references: [id])
  purchaseOrder     PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@index([itemId])
}

model GoodsReceipt {
  id              String             @id @default(cuid())
  receiptNumber   String             @unique
  purchaseOrderId String
  locationId      String
  receivedDate    DateTime
  receivedById    String
  status          GoodsReceiptStatus @default(PENDING)
  notes           String?
  orgId           String
  total           Float              @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  location        Location           @relation(fields: [locationId], references: [id])
  organisation    Organisation       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  purchaseOrder   PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  receivedBy      User               @relation("GoodsReceiptReceivedBy", fields: [receivedById], references: [id])
  lines           GoodsReceiptLine[]

  @@index([receiptNumber])
  @@index([purchaseOrderId])
}

model GoodsReceiptLine {
  id                  String            @id @default(cuid())
  goodsReceiptId      String
  purchaseOrderLineId String
  itemId              String
  receivedQuantity    Int
  notes               String?
  serialNumbers       String[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  goodsReceipt        GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  item                Item              @relation(fields: [itemId], references: [id])
  purchaseOrderLine   PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id])

  @@index([goodsReceiptId])
  @@index([purchaseOrderLineId])
  @@index([itemId])
}

model Customer {
  id           String        @id @default(cuid())
  name         String
  email        String?
  phone        String?
  address      String?
  taxId        String?
  notes        String?
  isActive     Boolean       @default(true)
  orgId        String
  imageUrl     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  organisation Organisation  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  salesOrders  SalesOrder[]
  salesReturns SalesReturn[]
  ManualDebt   ManualDebt[]

  @@index([email])
  @@index([phone])
}

model SalesOrder {
  id            String              @id @default(cuid())
  orderNumber   String              @unique
  customerId    String?
  source        Source              @default(SALES_ORDER)
  locationId    String?
  status        SalesOrderStatus    @default(DRAFT)
  subtotal      Float               @default(0)
  taxAmount     Float               @default(0)
  shippingCost  Float?
  discount      Float?              @default(0)
  notes         String?
  paymentStatus PaymentStatus       @default(PENDING)
  paymentMethod String?
  amountPaid    Float               @default(0)
  amountOwing   Float               @default(0)
  deliveryDate  DateTime?
  orgId         String
  createdById   String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  createdBy     User                @relation("SalesOrderCreatedBy", fields: [createdById], references: [id])
  customer      Customer?           @relation(fields: [customerId], references: [id])
  location      Location?           @relation("SalesLocation", fields: [locationId], references: [id])
  organisation  Organisation        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lines         SalesOrderLine[]
  salesReturns  SalesReturn[]
  payments      SalesOrderPayment[]

  @@index([orderNumber])
  @@index([customerId])
  @@index([paymentStatus])
}

model SalesOrderLine {
  id            String     @id @default(cuid())
  salesOrderId  String
  itemId        String
  quantity      Int
  notes         String?
  unitPrice     Float
  taxRate       Float      @default(0)
  taxAmount     Float      @default(0)
  discount      Float?
  total         Float
  serialNumbers String[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  item          Item       @relation(fields: [itemId], references: [id])
  salesOrders   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  @@index([salesOrderId])
  @@index([itemId])
}

model SalesOrderPayment {
  id           String        @id @default(cuid())
  orderId      String
  orgId        String
  amount       Float
  method       PaymentMethod
  reference    String?
  paidAt       DateTime      @default(now())
  recordedById String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  order      SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  recordedBy User?      @relation("PaymentRecordedBy", fields: [recordedById], references: [id])

  @@index([orderId])
  @@index([orgId])
}

model Transfer {
  id             String         @id @default(cuid())
  transferNumber String         @unique
  date           DateTime
  fromLocationId String
  toLocationId   String
  status         TransferStatus @default(DRAFT)
  notes          String?
  orgId          String
  createdById    String
  approvedById   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  approvedBy     User?          @relation("TransferApprovedBy", fields: [approvedById], references: [id])
  createdBy      User           @relation("TransferCreatedBy", fields: [createdById], references: [id])
  fromLocation   Location       @relation("FromLocation", fields: [fromLocationId], references: [id])
  organisation   Organisation   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  toLocation     Location       @relation("ToLocation", fields: [toLocationId], references: [id])
  lines          TransferLine[]

  @@index([transferNumber])
  @@index([fromLocationId])
  @@index([toLocationId])
}

model TransferLine {
  id            String   @id @default(cuid())
  transferId    String
  itemId        String
  quantity      Int
  notes         String?
  serialNumbers String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  item          Item     @relation(fields: [itemId], references: [id])
  transfer      Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([transferId])
  @@index([itemId])
}

model Adjustment {
  id               String           @id @default(cuid())
  adjustmentNumber String           @unique
  date             DateTime
  locationId       String?
  adjustmentType   AdjustmentType
  reason           String
  notes            String?
  status           AdjustmentStatus @default(DRAFT)
  orgId            String
  createdById      String
  approvedById     String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  approvedBy       User?            @relation("AdjustmentApprovedBy", fields: [approvedById], references: [id])
  createdBy        User             @relation("AdjustmentCreatedBy", fields: [createdById], references: [id])
  location         Location?        @relation(fields: [locationId], references: [id])
  organisation     Organisation     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lines            AdjustmentLine[]

  @@index([adjustmentNumber])
  @@index([locationId])
  @@index([adjustmentType])
}

model AdjustmentLine {
  id               String     @id @default(cuid())
  adjustmentId     String
  itemId           String
  locationId       String?
  beforeQuantity   Int
  afterQuantity    Int
  adjsutedQuantity Int
  notes            String?
  serialNumbers    String[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  adjustment       Adjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  item             Item       @relation(fields: [itemId], references: [id])
  location         Location?  @relation(fields: [locationId], references: [id])

  @@index([adjustmentId])
  @@index([itemId])
}

model ApiKey {
  id        String       @id @default(cuid())
  orgId     String
  key       String       @unique
  name      String
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  org       Organisation @relation(fields: [orgId], references: [id])
}

model Invite {
  id           String       @id @default(cuid())
  name         String?
  email        String       @unique
  orgId        String
  status       Boolean      @default(false)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("Invites")
}

model Changelog {
  id          String   @id @default(cuid())
  title       String
  version     String
  content     String
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Feedback {
  id        String         @id @default(cuid())
  type      FeedbackType
  title     String
  content   String
  status    FeedbackStatus @default(PENDING)
  userId    String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id])
}

model Showcase {
  id          String         @id @default(cuid())
  title       String
  description String
  projectUrl  String?
  githubUrl   String?
  imageUrl    String
  technology  String[]
  status      ShowcaseStatus @default(PENDING)
  userId      String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id])
}

model InventoryTransaction {
  id              String          @id @default(cuid())
  itemId          String
  locationId      String
  type            TransactionType
  quantity        Int
  referenceNumber String?
  notes           String?
  orgId           String
  userId          String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  item            Item            @relation(fields: [itemId], references: [id], onDelete: Cascade)
  location        Location        @relation(fields: [locationId], references: [id], onDelete: Cascade)
  organisation    Organisation    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id])

  @@index([itemId])
  @@index([locationId])
  @@index([orgId])
  @@index([type])
  @@index([createdAt])
}

model PackagingUnit {
  id           String            @id @default(cuid())
  name         String // "Box", "Half Sack", "Crate", "Dozen"
  description  String?
  orgId        String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  organisation Organisation      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  pricingTiers ItemPricingTier[]

  @@unique([name, orgId])
  @@index([orgId])
}

model ItemPricingTier {
  id              String        @id @default(cuid())
  itemId          String
  packagingUnitId String
  unitsPerPack    Int // e.g. 6 → "1 box contains 6 items"
  wholesalePrice  Float // e.g. 48.00 → "1 box = GHS 48.00"
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  item            Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  packagingUnit   PackagingUnit @relation(fields: [packagingUnitId], references: [id], onDelete: Cascade)

  @@unique([itemId, packagingUnitId])
  @@index([itemId])
}

model SalesReturn {
  id           String            @id @default(cuid())
  rmaNumber    String            @unique
  salesOrderId String?
  customerId   String?
  locationId   String
  status       ReturnStatus      @default(PENDING)
  reason       String?
  notes        String?
  refundAmount Float             @default(0)
  refundMethod String?
  orgId        String
  createdById  String
  approvedById String?
  receivedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  lines        SalesReturnLine[]
  salesOrder   SalesOrder?       @relation(fields: [salesOrderId], references: [id])
  customer     Customer?         @relation(fields: [customerId], references: [id])
  location     Location          @relation(fields: [locationId], references: [id])
  organisation Organisation      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy    User              @relation("ReturnCreatedBy", fields: [createdById], references: [id])
  approvedBy   User?             @relation("ReturnApprovedBy", fields: [approvedById], references: [id])

  @@index([rmaNumber])
  @@index([salesOrderId])
  @@index([customerId])
  @@index([orgId])
  @@index([status])
}

model SalesReturnLine {
  id            String      @id @default(cuid())
  returnId      String
  itemId        String
  quantity      Int
  unitPrice     Float       @default(0)
  condition     String? // GOOD | DAMAGED | DEFECTIVE
  restockable   Boolean     @default(true)
  notes         String?
  serialNumbers String[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  salesReturn   SalesReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  item          Item        @relation(fields: [itemId], references: [id])

  @@index([returnId])
  @@index([itemId])
}

model ManualDebt {
  id          String   @id @default(cuid())
  orgId       String
  customerId  String
  amountOwing Float    @default(0)
  amountPaid  Float    @default(0)
  status      String   @default("PENDING") // PENDING, PARTIAL, PAID, CANCELLED
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  org      Organisation @relation(fields: [orgId], references: [id])

  payments ManualDebtPayment[]

  @@index([orgId])
  @@index([customerId])
  @@index([status])
}

model ManualDebtPayment {
  id           String   @id @default(cuid())
  manualDebtId String
  amount       Float
  method       String // CASH, MOMO, CREDIT_CARD
  reference    String?
  paidAt       DateTime @default(now())
  recordedById String
  orgId        String

  manualDebt ManualDebt @relation(fields: [manualDebtId], references: [id], onDelete: Cascade)
  recordedBy User       @relation(fields: [recordedById], references: [id])

  @@index([manualDebtId])
  @@index([orgId])
}

model ManualSupplierDebt {
  id          String   @id @default(cuid())
  orgId       String
  supplierId  String
  amountOwing Float    @default(0)
  amountPaid  Float    @default(0)
  status      String   @default("PENDING") // PENDING, PARTIAL, PAID, CANCELLED
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  supplier Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  org      Organisation @relation(fields: [orgId], references: [id])

  payments ManualSupplierDebtPayment[]

  @@index([orgId])
  @@index([supplierId])
  @@index([status])
}

model ManualSupplierDebtPayment {
  id                   String   @id @default(cuid())
  manualSupplierDebtId String
  amount               Float
  method               String // CASH, BANK_TRANSFER, MOBILE_MONEY, CHEQUE
  reference            String?
  paidAt               DateTime @default(now())
  recordedById         String
  orgId                String

  manualSupplierDebt ManualSupplierDebt @relation(fields: [manualSupplierDebtId], references: [id], onDelete: Cascade)
  recordedBy         User               @relation(fields: [recordedById], references: [id])

  @@index([manualSupplierDebtId])
  @@index([orgId])
}

model Expense {
  id          String       @id @default(cuid())
  orgId       String
  description String
  category    String // "Operations" | "Logistics" | ... | "Payroll"
  amount      Float
  date        DateTime     @default(now())
  recordedBy  String? // user name / id
  isPayroll   Boolean      @default(false)
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  org         Organisation @relation(fields: [orgId], references: [id])
}

model PayrollEntry {
  id           String       @id @default(cuid())
  orgId        String
  employeeName String
  role         String?
  amount       Float
  period       String // "March 2024"
  date         DateTime     @default(now())
  status       String       @default("PENDING") // "PAID" | "PENDING"
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  org          Organisation @relation(fields: [orgId], references: [id])
}

model SupplierPayment {
  id              String                @id @default(cuid())
  purchaseOrderId String
  amount          Float
  method          SupplierPaymentMethod
  reference       String? // bank ref, cheque no., MoMo ID
  notes           String?
  paidAt          DateTime              @default(now())
  recordedById    String
  orgId           String
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  recordedBy    User          @relation("SupplierPaymentRecorder", fields: [recordedById], references: [id])
  organisation  Organisation  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@index([orgId])
  @@index([paidAt])
}

